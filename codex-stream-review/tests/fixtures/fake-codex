#!/usr/bin/env bash
# Fake `codex` CLI -- a full drop-in for every way tests/test-run-ccs-review.sh
# lets run-ccs-review.sh invoke a real `codex` binary, so that suite never
# reaches the real Codex backend: no API calls, no network, regardless of
# which wrapper code path (exec, exec resume, or delete --force) a given
# fixture exercises.
#
# Invoked exactly the way run-ccs-review.sh invokes the real `codex`:
#   codex exec --json --sandbox read-only -o LAST_MESSAGE_FILE \
#     -c model_reasoning_effort=xhigh [--output-schema PATH] < PROMPT_FILE
#   codex exec resume <threadId> --json -o LAST_MESSAGE_FILE \
#     [--output-schema PATH] < PROMPT_FILE
#   codex delete --force -- <threadId>
# All of that is accepted and ignored -- behavior here is selected purely
# via env vars (FAKE_CODEX_*), since the wrapper controls our argv, not the
# caller of this fixture. Stdin (the prompt) is never read; it's a plain
# file redirect, not a pipe, so leaving it unread cannot block.
#
# Env vars:
#   FAKE_CODEX_SCENARIO   normal | exit_nonzero | no_task_complete |
#                         no_final_answer | invalid_json | schema_mismatch |
#                         hang   (default: normal)
#   FAKE_CODEX_EXIT_CODE  exit code for exit_nonzero (default: 1)
#   FAKE_CODEX_SLEEP_SECS sleep duration for hang's stall or
#                         no_thread_started's stall (default depends on
#                         scenario)
#   FAKE_CODEX_FINAL_ANSWER  raw text written to the file passed via -o (the
#                         wrapper's --output-last-message target), for
#                         normal/invalid_json/schema_mismatch (default: a
#                         schema-conformant CLEAN verdict)
#   FAKE_CODEX_MARKER_FILE  if set, touched immediately on start so a test
#                         can detect "dispatch genuinely began" (needed for
#                         --resume, which has no thread.started event to
#                         poll for)
#   FAKE_CODEX_CLEANUP_OK  when set (any value), `codex delete --force --
#                         <threadId>` (the wrapper's --cleanup mode) exits 0
#                         instead of its default failing behavior. Unset
#                         (default): unchanged, always fails -- every
#                         existing test-run-ccs-review.sh --cleanup fixture
#                         relies on this default and passes a deliberately
#                         nonexistent threadId.
#   FAKE_CODEX_COMMANDS   newline-separated shell command strings (blank
#                         lines skipped). When set, emits one
#                         {"type":"item.completed","item":{"type":"command_execution",...}}
#                         JSON line per command to stdout, for
#                         --capture-eventlog investigation_evidence tests.
#                         Unset (default): no such lines, stdout unchanged.
#   FAKE_CODEX_GARBAGE_LINE  when set (any value), emits one line of
#                         deliberately non-JSON text to stdout, to test that
#                         extraction's `fromjson?` tolerates a malformed
#                         line. Unset (default): no such line.
#   FAKE_CODEX_NO_THREAD_STARTED  when set (any value), for a FRESH dispatch
#                         only (--resume already has no thread.started
#                         concept, so this never affects it): skip emitting
#                         the thread.started line, then sleep (honors
#                         FAKE_CODEX_SLEEP_SECS, default 11s) before exiting,
#                         so the wrapper's own real THREAD_WAIT_SECS=10s poll
#                         genuinely times out. Simulates the no_thread_started
#                         condition, which is otherwise unreachable from this
#                         fixture (a fresh dispatch always emits
#                         thread.started unconditionally, before ever
#                         looking at $FAKE_CODEX_SCENARIO). Unset (default):
#                         stdout unchanged, byte-for-byte.
#   FAKE_CODEX_USAGE_JSON  for execution-telemetry tests: the raw JSON value
#                         to emit as the turn.completed event's own "usage"
#                         field. Unset (default): "usage":{} (an empty
#                         object -- matches the real CLI's own confirmed
#                         behavior on some successful turns, per this
#                         project's own execution-telemetry design). Set to
#                         the literal string "null" to omit the "usage" key
#                         from the event entirely (a genuinely absent
#                         usage), or to the literal string "JSON_NULL" to
#                         instead emit the key with a real JSON `null` value
#                         ("usage":null) -- both are treated identically by
#                         the production jq extraction, but are exercised as
#                         two distinct fixture cases rather than assumed
#                         equivalent. Set to a real non-empty JSON object (e.g.
#                         '{"input_tokens":12,"output_tokens":34}') to
#                         simulate a populated usage report. Only affects
#                         the normal/invalid_json/schema_mismatch scenario's
#                         own turn.completed event below -- no_task_complete
#                         never emits turn.completed at all, and
#                         no_final_answer emits its own turn.completed
#                         separately (see below).
#   FAKE_CODEX_INVOCATION_LOG  optional file path. When set, on EVERY
#                         invocation of this fixture -- regardless of
#                         scenario, including the `delete` subcommand --
#                         appends one line recording this invocation's mode
#                         (fresh|resume|delete), its resolved
#                         THREAD_ID/RESUME_ID (whichever applies; empty for
#                         a fresh dispatch under FAKE_CODEX_NO_THREAD_STARTED,
#                         since no thread id is ever generated on that path),
#                         and the FAKE_CODEX_SCENARIO value in effect. Lets a
#                         scenario's own expect.sh verify this fake binary
#                         was ACTUALLY invoked the expected number of times,
#                         in the expected mode sequence -- catching a silent
#                         PATH-injection failure where a scenario's setup
#                         accidentally let a call fall through to a
#                         different (or worse, real) `codex` binary. Appends
#                         via a plain `>>` (no flock) -- this project's own
#                         convention elsewhere tolerates non-atomic appends
#                         for best-effort diagnostics. Each SEPARATE scenario
#                         using this should point it at its own dedicated
#                         file, not a shared one across concurrent
#                         processes: a future parallel-mode scenario must use
#                         one such log PER GROUP, never one shared log across
#                         groups, to avoid any assumption of total ordering
#                         across concurrently-dispatched processes. Unset
#                         (default): zero behavior change, nothing written,
#                         matches every existing test exactly.
#   FAKE_CODEX_GROUP_STATE  optional directory path. When set, this fixture
#                         becomes STATEFUL across invocations sharing the
#                         same directory (every invocation is otherwise
#                         independent/stateless -- no memory of prior
#                         calls). On each invocation: reads an integer round
#                         counter from "$FAKE_CODEX_GROUP_STATE/round"
#                         (default 0 if absent); if
#                         "$FAKE_CODEX_GROUP_STATE/round-<N>-final-answer.json"
#                         exists for the CURRENT counter value N, its content
#                         is used as this invocation's FAKE_CODEX_FINAL_ANSWER
#                         instead of whatever the FAKE_CODEX_FINAL_ANSWER env
#                         var says (that env var is still the fallback when
#                         no per-round file exists for the current counter);
#                         after that, the counter file is incremented by 1
#                         for the NEXT invocation, regardless of whether a
#                         per-round file existed for this one. This lets a
#                         scenario's setup.sh pre-populate
#                         round-0-final-answer.json, round-1-final-answer.json,
#                         etc. as a full scripted transcript, played back in
#                         order across real, separate, fresh-shell dispatch
#                         calls -- the counter file is the only persistence
#                         mechanism available across those separate process
#                         invocations. A caller using this for PARALLEL-mode
#                         testing MUST give each group its own separate
#                         FAKE_CODEX_GROUP_STATE directory, bound per-command
#                         (e.g. `FAKE_CODEX_GROUP_STATE="/tmp/.../g1-state"
#                         run-ccs-review.sh ...` prefixed directly on that
#                         group's own dispatch line), NEVER a shared `export`
#                         mutated between concurrent group dispatches -- a
#                         shared/exported directory would let concurrent
#                         groups race on the same round counter. Unset
#                         (default): zero behavior change, matches every
#                         existing test exactly.
set -u

# Appends one line to $FAKE_CODEX_INVOCATION_LOG (if set) recording this
# invocation -- see the env var's own doc comment above. A no-op when unset.
log_invocation() {
  # $1 = mode (fresh|resume|delete), $2 = resolved thread/resume id (may be
  # empty, e.g. a fresh dispatch under FAKE_CODEX_NO_THREAD_STARTED).
  [ -n "${FAKE_CODEX_INVOCATION_LOG:-}" ] || return 0
  printf 'mode=%s thread_id=%s scenario=%s\n' \
    "$1" "$2" "${FAKE_CODEX_SCENARIO:-normal}" >> "$FAKE_CODEX_INVOCATION_LOG"
}

# `codex delete --force -- <threadId>` (run-ccs-review.sh's --cleanup mode)
# is a completely separate subcommand from `exec`/`exec resume` -- handled
# here, first, so this fixture is a full drop-in for every way the wrapper
# ever invokes `codex`, not just its exec paths. Fails (nonzero exit) by
# default: every caller of --cleanup in tests/test-run-ccs-review.sh passes a
# deliberately nonexistent threadId, so "delete failed" is the realistic,
# correct simulated outcome there, not a special case invented for this
# fixture. FAKE_CODEX_CLEANUP_OK (unset by default, so every existing test
# above is byte-for-byte unaffected) opts into the opposite, successful
# outcome instead -- needed by codex-stream-review/evals/, which drives a
# real end-to-end /ccs session and needs to observe genuine
# threads[].cleanup:"deleted" in the resulting .result.json, not just the
# always-fails path this fixture only exercised until now.
if [ "${1:-}" = "delete" ]; then
  # Real invocation shape is fixed (`delete --force -- <threadId>`), so the
  # last positional argument is always the target threadId.
  DELETE_TARGET=""
  for ARG in "$@"; do DELETE_TARGET="$ARG"; done
  log_invocation delete "$DELETE_TARGET"
  if [ -n "${FAKE_CODEX_CLEANUP_OK:-}" ]; then
    exit 0
  fi
  echo "fake-codex: no such thread" >&2
  exit 1
fi

[ -n "${FAKE_CODEX_MARKER_FILE:-}" ] && : > "$FAKE_CODEX_MARKER_FILE"

MODE=fresh
RESUME_ID=""
if [ "${2:-}" = "resume" ]; then
  MODE=resume
  RESUME_ID="${3:-}"
fi

SCENARIO="${FAKE_CODEX_SCENARIO:-normal}"

# Both real wrappers always pass `-o <path>` (their LAST_MESSAGE_FILE) on
# every dispatch, fresh or resumed -- scan argv for it rather than assuming
# a fixed position, since the flag sits at a different offset between the
# fresh and resume argv shapes (see the invocation forms documented above).
LAST_MESSAGE_FILE_PATH=""
PREV_ARG=""
for ARG in "$@"; do
  if [ "$PREV_ARG" = "-o" ]; then
    LAST_MESSAGE_FILE_PATH="$ARG"
    break
  fi
  PREV_ARG="$ARG"
done

if [ "$MODE" = "resume" ]; then
  THREAD_ID="$RESUME_ID"
  log_invocation resume "$THREAD_ID"
  # No thread.started to emit (the wrapper never polls for one on
  # --resume), but printing something distinctive still lets a
  # --capture-eventlog test confirm the eventlog holds this process's raw
  # output.
  echo "FAKE_CODEX_RESUME_MODE thread_id=$THREAD_ID"
else
  if [ -n "${FAKE_CODEX_NO_THREAD_STARTED:-}" ]; then
    # No thread.started line -- just outlive the wrapper's real (hardcoded,
    # not configurable) THREAD_WAIT_SECS=10s poll so its wait loop genuinely
    # times out rather than exiting early. No THREAD_ID is ever generated on
    # this path, so the invocation log records an empty thread_id.
    log_invocation fresh ""
    sleep "${FAKE_CODEX_SLEEP_SECS:-11}"
    exit 0
  fi
  THREAD_ID="$(python3 -c 'import uuid; print(uuid.uuid4())' 2>/dev/null)"
  [ -n "$THREAD_ID" ] || THREAD_ID="fake-$$-${RANDOM}"
  log_invocation fresh "$THREAD_ID"
  jq -nc --arg tid "$THREAD_ID" '{type: "thread.started", thread_id: $tid}'
fi

# Optional command_execution / garbage stdout lines for --capture-eventlog
# tests -- placed after the mode's own distinctive first line (thread.started
# for fresh, the resume marker line for resume) to match the realistic
# sequence. A no-op, byte-for-byte identical to before, when both env vars
# are unset (the default every pre-existing fixture relies on).
if [ -n "${FAKE_CODEX_GARBAGE_LINE:-}" ]; then
  echo "not valid json at all"
fi
if [ -n "${FAKE_CODEX_COMMANDS:-}" ]; then
  while IFS= read -r _cmd; do
    [ -n "$_cmd" ] || continue
    jq -nc --arg cmd "$_cmd" '{type: "item.completed", item: {type: "command_execution", command: $cmd}}'
  done <<< "$FAKE_CODEX_COMMANDS"
fi

# FAKE_CODEX_GROUP_STATE (see doc comment above): read the per-round
# scripted final-answer override, if any, for the CURRENT round counter
# value, then advance the counter for the next invocation. A no-op, byte-
# for-byte identical to before, when unset (the default every pre-existing
# fixture relies on).
GROUP_STATE_OVERRIDE=""
if [ -n "${FAKE_CODEX_GROUP_STATE:-}" ]; then
  mkdir -p "$FAKE_CODEX_GROUP_STATE" 2>/dev/null
  ROUND_FILE="$FAKE_CODEX_GROUP_STATE/round"
  ROUND_N=0
  [ -f "$ROUND_FILE" ] && ROUND_N="$(cat "$ROUND_FILE" 2>/dev/null)"
  case "$ROUND_N" in ''|*[!0-9]*) ROUND_N=0 ;; esac
  ROUND_ANSWER_FILE="$FAKE_CODEX_GROUP_STATE/round-${ROUND_N}-final-answer.json"
  [ -f "$ROUND_ANSWER_FILE" ] && GROUP_STATE_OVERRIDE="$(cat "$ROUND_ANSWER_FILE")"
  echo "$((ROUND_N + 1))" > "$ROUND_FILE"
fi

DEFAULT_VERDICT='{"verdict":"CLEAN","findings":[],"summary":null,"dimensions":{"correctness":{"status":"not_applicable","evidence":"e"},"security":{"status":"not_applicable","evidence":"e"},"performance":{"status":"not_applicable","evidence":"e"},"reuse":{"status":"not_applicable","evidence":"e"},"contracts":{"status":"not_applicable","evidence":"e"},"resources_concurrency":{"status":"not_applicable","evidence":"e"},"intent":{"status":"not_applicable","evidence":"e"}},"material_reviewed":true,"material_receipt":null,"material_receipt_index":null}'
if [ -n "$GROUP_STATE_OVERRIDE" ]; then
  FINAL_ANSWER="$GROUP_STATE_OVERRIDE"
else
  FINAL_ANSWER="${FAKE_CODEX_FINAL_ANSWER:-$DEFAULT_VERDICT}"
fi

# emit_turn_completed -> the one "type":"turn.completed" event every
# reachable scenario below emits (no_task_complete is the sole exception --
# it never emits this at all, by design). FAKE_CODEX_USAGE_JSON controls
# the event's own "usage" field: unset defaults to an empty object (the
# real CLI's own confirmed on-some-turns behavior); the literal string
# "null" omits the "usage" key entirely (a genuinely absent usage); the
# literal string "JSON_NULL" emits the key with a genuine JSON `null` value
# (`"usage":null`, distinct from an absent key -- both are exercised
# separately since the production jq extraction treats them identically,
# but the fixture matrix should prove that, not assume it); any other value
# is passed through verbatim as the raw JSON usage object.
emit_turn_completed() {
  # NOTE: deliberately not `${FAKE_CODEX_USAGE_JSON:-{}}` -- bash mis-parses
  # a literal `{}` default alongside a SET, brace-containing value in that
  # exact expansion form (confirmed directly: it silently appends a stray
  # extra `}`), so the empty-object default is applied via a plain `if`
  # instead.
  local usage_raw='{}'
  [ -n "${FAKE_CODEX_USAGE_JSON:-}" ] && usage_raw="$FAKE_CODEX_USAGE_JSON"
  if [ "$usage_raw" = "null" ]; then
    jq -nc '{type: "turn.completed"}'
  elif [ "$usage_raw" = "JSON_NULL" ]; then
    jq -nc '{type: "turn.completed", usage: null}'
  else
    jq -nc --argjson usage "$usage_raw" '{type: "turn.completed", usage: $usage}'
  fi
}

case "$SCENARIO" in
  hang)
    # Used for `timeout` (the wrapper's own --timeout deadline fires while
    # this is still sleeping) and `interrupted` (the test sends SIGTERM to
    # the WRAPPER, not to us, while we're still running).
    sleep "${FAKE_CODEX_SLEEP_SECS:-30}"
    exit 0
    ;;
  exit_nonzero)
    exit "${FAKE_CODEX_EXIT_CODE:-1}"
    ;;
  no_task_complete)
    # Exit clean without ever emitting turn.completed.
    exit 0
    ;;
  no_final_answer)
    # turn.completed fires, but -o is deliberately never written -- matches
    # how a real `-o` file would be absent if the agent never produced a
    # final message despite the turn nominally completing.
    emit_turn_completed
    exit 0
    ;;
  invalid_json|schema_mismatch|normal)
    emit_turn_completed
    if [ -n "$LAST_MESSAGE_FILE_PATH" ]; then
      printf '%s' "$FINAL_ANSWER" > "$LAST_MESSAGE_FILE_PATH"
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
